# pnpm 11 installs a production node_modules in the pre-script deps-status-check
# whenever the recorded workspace state drifts (e.g. after a locked/filtered
# `--prod` deploy leaves `production` set). That destructive reinstall prunes
# devDependencies and breaks the root postinstall, so disable it: the build
# scripts own dependency staging explicitly.
#
# Tradeoff: the pre-script check that fails fast when the lockfile and
# node_modules drift is also disabled repo-wide. Keep `pnpm install` a manual
# first step after dependency changes; CI runs `--frozen-lockfile` and
# re-installs from scratch, so the check is not what keeps CI honest.
verify-deps-before-run=false
